[Unit]
Description=Raspi4 P1 + RGB camera field recorder (thermal + detection + RGB events)
# No After=network.target: this has no network dependency at all, and the
# thermal capture loop already retries its own USB connection on its own if
# the camera hasn't enumerated yet when this starts.

[Service]
Type=simple
User=ale
WorkingDirectory=/home/ale/Code/Raspi4_P1_PiCam
ExecStart=/home/ale/venv/bin/python3 field_recorder.py \
    --thermal-outdir /home/ale/Code/Raspi4_P1_PiCam/recordings_20261008_thermal \
    --rgb-outdir /home/ale/Code/Raspi4_P1_PiCam/recordings_20261008_rgb_events \
    --thermal-fps 12.5 --segment-seconds 3600 \
    --thermal-rotate-degrees 180 \
    --rgb-width 1640 --rgb-height 1232 --rgb-fps 30 --rgb-format avi-jpeg \
    --pre-roll-seconds 2 --post-roll-seconds 2
Restart=always
RestartSec=10
# Give systemd time to deliver SIGTERM and let the current segment/clip
# close cleanly before it escalates to SIGKILL.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
